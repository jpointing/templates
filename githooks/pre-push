#!/bin/sh
# Shared push gate (templates repo). Refuses a push unless:
#   1. Git ran this checkout's own tracked hook (not one from another checkout);
#   2. it is not from local main, to main, or a deletion of a shared branch;
#   3. a shared branch (issues/*, fix/*, feature/*) only moves forward;
#   4. the branch contains its PR base, and an open PR targets that same base;
#   5. the secret scan, formatting check and host tests pass.
# Per-repo commands live in .githooks/hooks.conf (see hooks.conf.example).
#
# PR base: origin/main by default. For a branch that targets an issues or
# feature branch, set it once per branch:
#
#     git config branch.<name>.pushGateBase origin/issues/YYYY-MM-DD
#
# Install once per clone with .githooks/install.sh, which sets core.hooksPath to
# the relative .githooks. Agents must not bypass this with --no-verify.

set -u

remote=${1:-origin}
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
status=0

say() { printf 'pre-push: %s\n' "$*" >&2; }
fail() { say "FAIL ($1)"; shift; for line in "$@"; do printf '    %s\n' "$line" >&2; done; status=1; }

# --- 1. Hook location --------------------------------------------------------
# Some tools pin core.hooksPath to another checkout's absolute path. That copy
# is accepted only if it is byte-identical to this checkout's and the branch
# does not change the hook, since only then can it not be enforcing old rules.
canonical() {
    value=$(CDPATH='' cd -- "$1" 2>/dev/null && pwd -P) || return 1
    value=$(printf '%s' "$value" | tr '\\' '/')
    case "$value" in
        [A-Z]:*) first=${value%"${value#?}"}; value=$(printf '%s' "$first" | tr '[:upper:]' '[:lower:]')${value#?} ;;
    esac
    printf '%s\n' "$value"
}
here=$(canonical "$(dirname -- "$0")")
want=$(canonical "$root/.githooks")
if [ "$here" != "$want" ]; then
    if ! cmp -s -- "$0" "$root/.githooks/pre-push" \
       || ! git rev-parse --verify --quiet "refs/remotes/$remote/main" >/dev/null \
       || ! git diff --quiet "$remote/main" HEAD -- .githooks/; then
        fail hook-location "Git ran a pre-push hook from another checkout, and it differs from this one's." \
            "Point this checkout at its own hooks:" \
            "    git config --unset core.hooksPath; git config --worktree --unset core.hooksPath" \
            "    git config --global core.hooksPath .githooks"
        exit 1
    fi
fi

# --- Per-repo settings -------------------------------------------------------
HOOK_HOST_TESTS=''; HOOK_HOST_TESTS_MODE='block'; HOOK_FORMAT_CHECK=''
HOOK_SECRET_SCAN=''; HOOK_CHECK_PR_BASE=1
# shellcheck disable=SC1091
[ -f .githooks/hooks.conf ] && . ./.githooks/hooks.conf

# Child commands must not inherit GIT_DIR and friends from the hook, or a test
# that runs git in a temp repo will act on this repository instead.
# shellcheck disable=SC2046  # word splitting is intended: one -u NAME pair per variable
run_clean() { env $(env | sed -n 's/^\(GIT_[A-Za-z_]*\)=.*/-u \1/p') sh -c "$1"; }

git fetch --quiet "$remote" || { fail fetch "git fetch $remote failed." "Fix network or credentials, then push again."; exit 1; }

current=$(git branch --show-current)
if [ -z "$current" ] || [ "$current" = main ]; then
    fail branch "Pushing from local main or a detached HEAD is refused." \
        "Work on a named branch:  git switch -c <agent>/<purpose> $remote/main"
    exit 1
fi

pr_base_of() { # <branch> -> prints the PR base ref, or fails
    b=$1
    set_base=$(git config --get-all "branch.$b.pushGateBase" 2>/dev/null)
    if [ "$(printf '%s' "$set_base" | grep -c .)" -gt 1 ]; then
        fail branch-base "branch.$b.pushGateBase has more than one value."; return 1
    fi
    case "$b" in
        issues/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
            [ -n "$set_base" ] && { fail branch-base "An issues branch has no PR base override." "git config --unset branch.$b.pushGateBase"; return 1; }
            echo "$remote/main"; return 0 ;;
        */issues-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-main-sync*)
            [ -n "$set_base" ] && [ "$set_base" != "$remote/main" ] && { fail branch-base "A main-sync branch must target $remote/main."; return 1; }
            echo "$remote/main"; return 0 ;;
    esac
    base=${set_base:-$remote/main}
    case "${base#"$remote"/}" in
        main|feature/?*) ;;
        issues/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
        *) fail branch-base "PR base '$base' must be $remote/main, $remote/issues/YYYY-MM-DD or $remote/feature/<name>."; return 1 ;;
    esac
    echo "$base"
}

contains() { # <ref> <sha> <label>
    if ! git rev-parse --verify --quiet "refs/remotes/$1" >/dev/null; then
        fail branch-sync "$1 does not exist on $remote." "Create it, or set the right base: git config branch.<name>.pushGateBase <base>"
    elif ! git merge-base --is-ancestor "$1" "$2"; then
        fail branch-sync "$3 is $(git rev-list --count "$2..$1") commit(s) behind $1." "git fetch $remote && git merge $1"
    fi
}

checked_head=
while read -r local_ref local_sha remote_ref remote_sha; do
    target=${remote_ref#refs/heads/}
    source=${local_ref#refs/heads/}

    # --- 2/3. Branch safety --------------------------------------------------
    case "$local_sha" in *[!0]*) deleting=no ;; *) deleting=yes ;; esac
    case "$target" in main|issues/*|fix/*|feature/*) shared=yes ;; *) shared=no ;; esac
    if [ "$deleting" = yes ]; then
        [ "$shared" = yes ] && fail delete "Refusing to delete shared branch '$target'."
        continue
    fi
    if [ "$target" = main ]; then
        fail main "Refusing to push to main; it changes only through a pull request."; continue
    fi
    if [ "$source" = main ] || { [ "$local_ref" = HEAD ] && [ "$current" = main ]; }; then
        fail branch "Refusing to push local main to '$target'."; continue
    fi
    case "$remote_sha" in *[!0]*) existing=yes ;; *) existing=no ;; esac
    if [ "$shared" = yes ] && [ "$existing" = yes ]; then
        if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            fail stale "'$target' moved on $remote since your fetch." "git fetch $remote && git merge $remote/$target"; continue
        elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
            fail non-fast-forward "Refusing to rewrite shared branch '$target'; merge instead of rebasing or force-pushing."; continue
        fi
    fi

    # --- 4. PR base ----------------------------------------------------------
    base=$(pr_base_of "$target") || { status=1; continue; }
    contains "$base" "$local_sha" "$target"
    case "$target" in
        issues/*) git rev-parse --verify --quiet "refs/remotes/$remote/$target" >/dev/null \
                      && contains "$remote/$target" "$local_sha" "$target" ;;
        */issues-*-main-sync*)
            day=$(printf '%s' "$target" | sed -n 's/.*issues-\([0-9-]\{10\}\)-main-sync.*/\1/p')
            contains "$remote/issues/$day" "$local_sha" "$target" ;;
    esac
    if [ "$HOOK_CHECK_PR_BASE" = 1 ] && [ "$existing" = yes ] && command -v gh >/dev/null 2>&1; then
        open=$(gh pr list --head "$target" --state open --json baseRefName --jq '.[].baseRefName' 2>/dev/null) \
            || { fail pr-base "Cannot read the open PR for '$target' from GitHub." "Fix gh access, or set HOOK_CHECK_PR_BASE=0 in hooks.conf."; continue; }
        for pr_base in $open; do
            [ "$pr_base" = "${base#"$remote"/}" ] || fail pr-base "The open PR for '$target' targets $pr_base, but the gate checked against $base." \
                "git config branch.$target.pushGateBase $remote/$pr_base"
        done
    fi

    # --- 5. Secret scan ------------------------------------------------------
    if [ -n "$HOOK_SECRET_SCAN" ]; then
        PUSH_GATE_BASE=$base PUSH_GATE_SHA=$local_sha run_clean "export PUSH_GATE_BASE PUSH_GATE_SHA; $HOOK_SECRET_SCAN" \
            || fail secrets "The secret scan reported a possible secret (details above)."
    elif ! command -v gitleaks >/dev/null 2>&1; then
        fail secrets "gitleaks is not on PATH, so the secret scan can't run." "Install gitleaks 8.x and push again."
    else
        # Only the commits this push adds; CI scans the whole history monthly.
        gitleaks git --redact --no-banner --log-level warn --log-opts="$base..$local_sha" . >&2 \
            || fail secrets "gitleaks reported a possible secret (details above, redacted)." "Remove it from the commits before pushing."
    fi

    # Format and tests run on the working tree, so only for the checked-out commit.
    if [ "$local_sha" = "$(git rev-parse HEAD)" ]; then
        checked_head=$base
    else
        say "WARN: '$target' is not the checked-out commit, so formatting and host tests were not run for it."
    fi
done

[ $status -eq 0 ] || exit 1
[ -n "$checked_head" ] || exit 0
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    say "WARN: uncommitted changes are present, so formatting and tests ran on more than the pushed commit."
fi

# --- 5. Formatting and host tests --------------------------------------------
if [ -n "$HOOK_FORMAT_CHECK" ]; then
    PUSH_GATE_BASE=$checked_head run_clean "export PUSH_GATE_BASE; $HOOK_FORMAT_CHECK" \
        || fail format "Changed lines are not formatted (details above)." "Run the repo's formatter on the changed files, commit, and push again."
fi
if [ $status -eq 0 ] && [ -n "$HOOK_HOST_TESTS" ]; then
    if ! PUSH_GATE_BASE=$checked_head run_clean "export PUSH_GATE_BASE; $HOOK_HOST_TESTS" >&2; then
        if [ "$HOOK_HOST_TESTS_MODE" = warn ]; then
            say "WARN (host-tests): tests failed; push allowed, CI is the authority."
        else
            fail host-tests "Host tests failed (output above)."
        fi
    fi
fi
[ $status -eq 0 ] && say pass
exit $status
